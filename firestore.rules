rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember(groupId) {
      return exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // users — user only read/write own doc
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // otpQuota — DENY all client access (only Cloud Function via admin SDK)
    match /otpQuota/{phone} {
      allow read, write: if false;
    }

    // groups — anggota read, no client write (semua via Cloud Function)
    match /groups/{groupId} {
      allow read: if request.auth != null && isMember(groupId);
      allow write: if false;

      match /members/{memberId} {
        // Listing/get anggota dari dalam grup yang user ikuti.
        allow read: if request.auth != null && isMember(groupId);
        allow write: if false;
      }

      match /activityLog/{logId} {
        allow read: if request.auth != null && isMember(groupId);
        allow write, delete: if false; // append-only via Cloud Function
      }

      match /winners/{periodeId} {
        allow read: if request.auth != null && isMember(groupId);
        allow write: if false; // server-side only via Cloud Function
      }
    }

    // CollectionGroup query: user discover grup yang dia ikuti via
    // where('userId','==', auth.uid). Wildcard match WAJIB untuk collectionGroup
    // (Firestore tidak konsisten match nested path untuk collectionGroup auth check).
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Default deny — buka per-collection di phase berikutnya (PRD §7.1)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
